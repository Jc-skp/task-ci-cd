name: 11 - Filtrando por Type

on:
  pull_request:
    types: [opened, reopened, closed]
    branches: [ main, master ]

jobs:
  log-pr-event:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Log PR event
        run: |
          echo "🎯 O pull request foi ${{ github.event.action }}"
          echo "📌 Número do PR: ${{ github.event.number }}"
          echo "📝 Título: ${{ github.event.pull_request.title }}"
          echo "🔍 Estado: ${{ github.event.pull_request.state }}"
          
          if [ "${{ github.event.action }}" = "closed" ]; then
            if [ "${{ github.event.pull_request.merged }}" = "true" ]; then
              echo "✅ PR foi MERGED (mesclado)"
            else
              echo "❌ PR foi CLOSED (fechado sem merge)"
            fi
          fi
          
          echo "👤 Autor: ${{ github.event.pull_request.user.login }}"
          echo "📅 Criado em: ${{ github.event.pull_request.created_at }}"
          
